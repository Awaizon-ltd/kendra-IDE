# Copy to .env.local (or set in Vercel). Any chain left blank falls back to its public RPC.
NEXT_PUBLIC_RPC_ETHEREUM=
NEXT_PUBLIC_RPC_ARBITRUM=
NEXT_PUBLIC_RPC_OPTIMISM=
NEXT_PUBLIC_RPC_POLYGON=
NEXT_PUBLIC_RPC_ZKSYNC=
NEXT_PUBLIC_RPC_LINEA=
NEXT_PUBLIC_RPC_WORLDCHAIN=
NEXT_PUBLIC_RPC_ROBINHOOD=
NEXT_PUBLIC_RPC_MANTLE=
NEXT_PUBLIC_RPC_BERACHAIN=
NEXT_PUBLIC_RPC_SEPOLIA=
NEXT_PUBLIC_RPC_ARBITRUM_SEPOLIA=
NEXT_PUBLIC_RPC_OPTIMISM_SEPOLIA=

# WalletConnect Cloud project ID (public)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: Etherscan v2 key, the third fallback for ABI lookup after Sourcify and Blockscout
NEXT_PUBLIC_ETHERSCAN_API_KEY=
